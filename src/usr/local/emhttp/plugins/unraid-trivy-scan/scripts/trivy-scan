#!/bin/bash
# trivy-scan - scan the images of Docker containers, and the Unraid OS, with a pinned Trivy image (unraid-trivy-scan plugin).
#
# Commands:
#   start       start a scan in the background (returns at once)
#   run | cron  scan in the foreground (cron uses this)
#   stop        stop a running scan and remove this plugin's Trivy containers
#   update-db   download / refresh the vulnerability databases only
#   status      print the run state as key=value
#   apply       read the settings and write (or remove) the cron entry; never scans
#   config      print the validated settings as key=value
#   image       print the pinned Trivy image reference
#   uninstall   used by the plugin's remove step: stop, remove cron, optional data/image cleanup
#
# Container roles (all labelled unraid-trivy-scan=1 and unraid-trivy-scan.run=<run id>):
#   db      network, NO Docker socket: downloads the vulnerability DB (and the Java DB) into the data dir
#   local   Docker socket (needed to read local images), --network none, DB mounted read-only
#   remote  network, NO Docker socket, DB read-only; only with the registry check; the only one that may
#           receive /root/.docker/config.json (setting "Use registry logins")
#   os      --network none, NO Docker socket, DB read-only: "trivy rootfs" over the Unraid OS system directories
#           (OS_DIRS), each bind-mounted read-only and NON-recursively under /rootfs, so nothing mounted below them
#           (array, pools, /lib/firmware, libvirt image, ...) is visible. /mnt, /boot, /proc, /sys, /etc and
#           /var/lib/docker are never mounted.
# The socket is NOT a sandbox boundary: whoever holds it can ask Docker for anything. --network none, the
# read-only DB mount, --cap-drop ALL and no-new-privileges only narrow what a compromised scanner can do directly.
set -uo pipefail

NAME=unraid-trivy-scan
# The pinned scanner: version AND index digest in one place. To bump: read the release on
# https://github.com/aquasecurity/trivy/releases/latest, take the multi-arch index digest of the tag from both
# registries (HEAD /v2/aquasec/trivy/manifests/<ver> on registry-1.docker.io and /v2/aquasecurity/trivy/manifests/<ver>
# on ghcr.io, header Docker-Content-Digest; they must match), edit this line, bump the plugin version.
TRIVY_IMAGE="aquasec/trivy:0.76.1@sha256:790fd66d1697395d8693d1acaa1ea702406a20f109b6fc7bac8db623eca6c06c"

# UTS_* overrides exist for the offline tests only. Anyone who can set the environment of this root script is
# root already, so they are not a privilege boundary.
PLUGIN_DIR=${UTS_PLUGIN_DIR:-/usr/local/emhttp/plugins/$NAME}
CFG=${UTS_CFG:-/boot/config/plugins/$NAME/$NAME.cfg}
CRON_FILE=${UTS_CRON_FILE:-/boot/config/plugins/$NAME/$NAME.cron}
DOCKER_CFG=${UTS_DOCKER_CFG:-/boot/config/docker.cfg}
RUN=${UTS_RUN:-/var/run/$NAME}
LOG=${UTS_LOG:-/var/log/$NAME.log}
DOCKER_SOCK=${UTS_DOCKER_SOCK:-/var/run/docker.sock}
REG_AUTH=${UTS_REG_AUTH:-/root/.docker/config.json}
NOTIFY_BIN=${UTS_NOTIFY:-/usr/local/emhttp/webGui/scripts/notify}
UPDATE_CRON=${UTS_UPDATE_CRON:-/usr/local/sbin/update_cron}
PHP=${UTS_PHP:-php}
AGG_MEMORY=${UTS_AGG_MEMORY:-2048M}   # PHP memory_limit for building the report (tests: a small value)
OS_ROOT=${UTS_OS_ROOT:-}              # tests: a local copy of an Unraid root filesystem instead of /
OS_KERNEL=${UTS_OS_KERNEL:-}          # tests: kernel version of that copy (default: uname -r)
PS_FILTER=${UTS_PS_FILTER:-}          # tests: restrict the container list (docker ps --filter value)
TRIVY_TIMEOUT_OVERRIDE=${UTS_TRIVY_TIMEOUT:-}   # tests: Trivy --timeout value (e.g. 1ms) to simulate a timeout
LABEL=$NAME
SELF=$(readlink -f "$0")

# Where Docker keeps appdata: DOCKER_APP_CONFIG_PATH in docker.cfg (read as data, last assignment wins). Only a plain
# absolute path under /mnt is accepted (letters, digits and . _ + @ -, no dot segments); anything else, or no
# file, gives /mnt/user/appdata. Same rules as uts_appdata_root() in include/lib.php (tests/unit.sh compares both).
appdata_root() {
  local line val='' seen=0 def=/mnt/user/appdata
  if [ -r "$DOCKER_CFG" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      line=${line%$'\r'}
      if [[ $line =~ ^DOCKER_APP_CONFIG_PATH=(.*)$ ]]; then val=${BASH_REMATCH[1]}; seen=1; fi
    done <"$DOCKER_CFG"
  fi
  [ "$seen" = 1 ] || { echo "$def"; return; }
  if [ ${#val} -ge 2 ] && [ "${val:0:1}" = '"' ] && [ "${val: -1}" = '"' ]; then val=${val:1:${#val}-2}; fi
  while [[ $val == */ ]]; do val=${val%/}; done
  if [[ $val =~ ^/mnt/[A-Za-z0-9._+@-]+(/[A-Za-z0-9._+@-]+)*$ ]] && ! [[ $val =~ (^|/)\.\.?(/|$) ]]; then echo "$val"; else echo "$def"; fi
}
DATA=${UTS_DATA:-$(appdata_root)/$NAME}

# ---------------------------------------------------------------- settings (data, never executed)
declare -A DEF=([SCHEDULE]="" [SCOPE]=running [TIMEOUT]=30 [JAVA_DB]=yes [REGISTRY_CHECK]=no [REGISTRY_AUTH]=no
                [NOTIFY]=yes [OS_SCAN]=yes [SHOW_TAB]=no [DASH_TILE]=yes [REMOVE_DATA]=no)
declare -A C
CFG_PROBLEMS=()

cron_field_ok() {   # cron_field_ok <field> <min> <max>
  local item a b items=()
  IFS=, read -ra items <<<"$1"    # read does not glob, so a "*" field stays literal
  for item in "${items[@]}"; do
    [[ $item =~ ^(\*|([0-9]{1,2})(-([0-9]{1,2}))?)(/([0-9]{1,2}))?$ ]] || return 1
    if [ "${BASH_REMATCH[1]}" != '*' ]; then
      a=$((10#${BASH_REMATCH[2]})); b=$a
      [ -n "${BASH_REMATCH[4]}" ] && b=$((10#${BASH_REMATCH[4]}))
      { [ "$a" -lt "$2" ] || [ "$b" -gt "$3" ] || [ "$a" -gt "$b" ]; } && return 1
    fi
    if [ -n "${BASH_REMATCH[6]}" ]; then
      { [ $((10#${BASH_REMATCH[6]})) -lt 1 ] || [ $((10#${BASH_REMATCH[6]})) -gt "$3" ]; } && return 1
    fi
  done
  [ -n "$1" ] && [[ $1 != *, ]] && [[ $1 != ,* ]] && [[ $1 != *,,* ]]
}

cron_valid() {   # exactly five space-separated fields of digits * / , -
  [[ $1 =~ ^[0-9*/,-]+(\ [0-9*/,-]+){4}$ ]] || return 1
  local mi h dom mon dow
  read -r mi h dom mon dow <<<"$1"
  cron_field_ok "$mi" 0 59 && cron_field_ok "$h" 0 23 && cron_field_ok "$dom" 1 31 \
    && cron_field_ok "$mon" 1 12 && cron_field_ok "$dow" 0 7
}

valid_value() {   # valid_value <key> <value>
  case $1 in
    SCHEDULE) [ -z "$2" ] || cron_valid "$2" ;;
    SCOPE)    [ "$2" = running ] || [ "$2" = all ] ;;
    TIMEOUT)  [[ $2 =~ ^[0-9]{1,3}$ ]] && [ $((10#$2)) -ge 5 ] && [ $((10#$2)) -le 240 ] ;;
    JAVA_DB|REGISTRY_CHECK|REGISTRY_AUTH|NOTIFY|OS_SCAN|SHOW_TAB|DASH_TILE|REMOVE_DATA) [ "$2" = yes ] || [ "$2" = no ] ;;
    *) return 1 ;;
  esac
}

load_config() {
  local k v line
  for k in "${!DEF[@]}"; do C[$k]=${DEF[$k]}; done
  CFG_PROBLEMS=()
  [ -r "$CFG" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    [[ $line =~ ^([A-Z_]+)=(.*)$ ]] || continue
    k=${BASH_REMATCH[1]}; v=${BASH_REMATCH[2]}
    [ -n "${DEF[$k]+set}" ] || continue
    if [ ${#v} -ge 2 ] && [ "${v:0:1}" = '"' ] && [ "${v: -1}" = '"' ]; then v=${v:1:${#v}-2}; fi
    if valid_value "$k" "$v"; then C[$k]=$v; else CFG_PROBLEMS+=("$k"); fi
  done <"$CFG"
  C[TIMEOUT]=$((10#${C[TIMEOUT]}))
}

# ---------------------------------------------------------------- helpers
ts()   { date '+%Y-%m-%d %H:%M:%S'; }
log()  { echo "$(ts) $*"; }
# Strings that reach status files: keep a conservative character set and length.
clean() { printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9._/:@ ()+,=-' '?' | cut -c1-"${2:-200}"; }

pid_alive() {   # pid_alive <pid>: a live process running this script
  [[ $1 =~ ^[0-9]{1,9}$ ]] || return 1
  [ -r "/proc/$1/cmdline" ] && tr '\0' ' ' <"/proc/$1/cmdline" | grep -q 'trivy-scan'
}
running_pid() { local p; p=$(cat "$RUN/pid" 2>/dev/null) || return 1; pid_alive "$p" && echo "$p"; }

kv_write() {   # kv_write <file> key=value...: atomic replace
  local f=$1 tmp; shift
  tmp="$f.tmp.$$"
  printf '%s\n' "$@" >"$tmp" && mv -f "$tmp" "$f"
}
progress() { kv_write "$RUN/progress" "phase=$1" "done=$2" "total=$3" "current=$(clean "${4:-}")"; }
last_run() { mkdir -p "$DATA/report" && kv_write "$DATA/report/last-run" "result=$1" "ended=$(date +%s)" "message=$(clean "$2" 300)"; }

WARNINGS=()
warn() { log "WARNING: $*"; WARNINGS+=("$*"); }

our_containers() {   # all containers of this plugin, or of one run
  local f="label=$LABEL=1"
  [ -n "${1:-}" ] && f="label=$LABEL.run=$1"
  docker ps -aq --filter "$f" 9>&- 2>/dev/null
}
# shellcheck disable=SC2086  # container ids are hex words
kill_containers() { local ids; ids=$(our_containers "${1:-}"); [ -n "$ids" ] && docker rm -f $ids >/dev/null 2>&1 9>&-; return 0; }

# docker run with this plugin's labels and hardening; output to $OUT_FILE/$ERR_FILE, killed after $HARD_LIMIT s.
CHILD=
RC=0
trivy_container() {   # trivy_container <role> <name> <docker run options...> -- <trivy args...>
  local role=$1 name=$2; shift 2
  local opts=()
  while [ $# -gt 0 ] && [ "$1" != -- ]; do opts+=("$1"); shift; done
  shift
  timeout -k 30 "$HARD_LIMIT" docker run --rm --name "$name" \
    --label "$LABEL=1" --label "$LABEL.run=$RUN_ID" --label "$LABEL.role=$role" \
    --cap-drop ALL --security-opt no-new-privileges "${opts[@]}" \
    "$TRIVY_IMAGE" "$@" >"$OUT_FILE" 2>"$ERR_FILE" 9>&- </dev/null &
  CHILD=$!
  wait "$CHILD"; RC=$?
  CHILD=
  if [ "$RC" -eq 124 ] || [ "$RC" -eq 137 ]; then docker rm -f "$name" >/dev/null 2>&1 9>&-; fi
  return "$RC"
}

fail_reason() {   # one line from the error output
  if [ "$RC" -eq 124 ] || [ "$RC" -eq 137 ] || grep -q 'context deadline exceeded' "$ERR_FILE" 2>/dev/null; then
    echo "timed out after ${C[TIMEOUT]} min (setting: Timeout per image)"; return
  fi
  local l
  l=$(sed -e 's/\x1b\[[0-9;]*[A-Za-z]//g' "$ERR_FILE" 2>/dev/null | grep -v '^[[:space:]]*$' | grep -E 'FATAL|ERROR|error' | tail -1)
  [ -n "$l" ] || l=$(grep -v '^[[:space:]]*$' "$ERR_FILE" 2>/dev/null | tail -1)
  [ -n "$l" ] || l="trivy exited with code $RC"
  clean "$l" 300
}

TRIVY_COMMON=(--cache-dir /cache --no-progress --disable-telemetry --skip-version-check)
SCAN_COMMON=(image "${TRIVY_COMMON[@]}" --cache-backend memory --skip-db-update --skip-java-db-update
             --offline-scan --scanners vuln --format json --quiet)

# ---------------------------------------------------------------- databases
update_db() {   # needs $RUN_ID, the lock and C[]
  mkdir -p "$DATA/cache" || { warn "cannot create $DATA/cache"; return 1; }
  local owner; owner=$(stat -c %u:%g "$DATA/cache")
  HARD_LIMIT=3600
  OUT_FILE=$RUN/db.out; ERR_FILE=$RUN/db.err
  progress db 0 0 "vulnerability database"
  log "updating the vulnerability DB"
  if ! trivy_container db "$NAME-$RUN_ID-db" --user "$owner" -e HOME=/tmp -v "$DATA/cache:/cache" -- \
       image "${TRIVY_COMMON[@]}" --download-db-only; then
    warn "vulnerability DB update failed: $(fail_reason)"
  fi
  if [ "${C[JAVA_DB]}" = yes ]; then
    progress db 0 0 "Java database"
    log "updating the Java DB"
    if ! trivy_container db "$NAME-$RUN_ID-javadb" --user "$owner" -e HOME=/tmp -v "$DATA/cache:/cache" -- \
         image "${TRIVY_COMMON[@]}" --download-java-db-only; then
      warn "Java DB update failed: $(fail_reason)"
    fi
  fi
  [ -s "$DATA/cache/db/trivy.db" ]
}

ensure_image() {
  docker image inspect "$TRIVY_IMAGE" >/dev/null 2>&1 9>&- && return 0
  progress pull 0 0 "Trivy image"
  log "pulling $TRIVY_IMAGE"
  docker pull -q "$TRIVY_IMAGE" >/dev/null 9>&-
}

# ---------------------------------------------------------------- image list
# images.tsv: idx id display ref stale digests containers noref-reason
# shellcheck disable=SC2086  # $ids: container ids, hex words separated by newlines
list_images() {
  local all=() ids _cid img cfgimg cname lab
  [ "${C[SCOPE]}" = all ] && all=(-a)
  local filt=()
  [ -n "$PS_FILTER" ] && filt=(--filter "$PS_FILTER")
  ids=$(docker ps "${all[@]}" -q --no-trunc "${filt[@]}" 9>&-) || return 1
  declare -gA IMG_NAME IMG_CONT
  IMG_ORDER=()
  [ -n "$ids" ] || return 0
  while IFS=$'\x1f' read -r _cid img cfgimg cname lab; do   # \x1f: not whitespace, so empty fields survive
    [ -n "$lab" ] && continue                       # our own Trivy containers
    [[ $img =~ ^sha256:[0-9a-f]{64}$ ]] || continue
    cname=$(clean "${cname#/}" 100)
    if [ -z "${IMG_NAME[$img]+set}" ]; then IMG_ORDER+=("$img"); IMG_NAME[$img]=$cfgimg; IMG_CONT[$img]=$cname
    else IMG_CONT[$img]+=",$cname"; fi
  done < <(docker inspect --format '{{.Id}}{{"\x1f"}}{{.Image}}{{"\x1f"}}{{.Config.Image}}{{"\x1f"}}{{.Name}}{{"\x1f"}}{{if index .Config.Labels "'"$LABEL"'"}}ours{{end}}' $ids 9>&-)
}

describe_image() {   # describe_image <id> <config image> -> DISPLAY REF STALE NOREF DIGESTS
  local id=$1 ci=$2 name last tagid
  DISPLAY='' REF='' STALE=0 NOREF=''
  DIGESTS=$(docker image inspect -f '{{join .RepoDigests ","}}' "$id" 9>&- 2>/dev/null)
  if [ -z "$ci" ] || [[ $ci =~ ^(sha256:)?[0-9a-f]{12,64}$ ]]; then
    DISPLAY="image ${id:7:12}"; NOREF="container was created from an image ID"; return
  fi
  name=${ci%%@*}; last=${name##*/}
  DISPLAY=$(clean "$ci" 200)
  if [[ $ci == *@* ]] && [[ $last != *:* ]]; then
    NOREF="image is pinned by digest"
  elif [ -z "$DIGESTS" ]; then
    # never pulled from a registry (docker build / compose build): there is nothing to compare with, and asking
    # Docker Hub for e.g. library/myapp-web only gives "authentication required"
    NOREF="image was built locally (no registry digest)"
  elif [[ $last == *:* ]]; then REF=$name
  else REF="$name:latest"; fi
  tagid=$(docker image inspect -f '{{.Id}}' "$ci" 9>&- 2>/dev/null)
  if [ -n "$tagid" ] && [ "$tagid" != "$id" ]; then
    STALE=1; DISPLAY="$DISPLAY (running older image ${id:7:12})"
  fi
  REF=$(clean "$REF" 200)
}

# read_row: next images.tsv line into idx id disp ref stale dig cont noref. Tabs are mapped to \x1f first because
# read with IFS=tab would merge empty fields (tab is IFS whitespace).
read_row() {
  local line
  IFS= read -r line || return 1
  IFS=$'\x1f' read -r idx id disp ref stale dig cont noref <<<"${line//$'\t'/$'\x1f'}"
}

# ---------------------------------------------------------------- the Unraid OS
# System directories given to the OS scanner. Unraid 7.x runs from RAM: bzroot is the root filesystem, /usr is an
# overlay on the bzmodules squashfs, /lib/firmware an overlay on bzfirmware. Only these are mounted, each read-only
# and non-recursive (bind-recursive=disabled: mounts below them are left out); a missing directory or a symlink is
# skipped. Not mounted: /etc (configuration and secrets; Trivy finds nothing there that it can match) and
# /var/lib/pkgtools (Trivy has no Slackware support; the package list is read here, on the host, for the report).
OS_DIRS=(usr lib lib64 bin sbin opt)
OS_SKIP=(/rootfs/lib/modules)          # kernel modules: nothing Trivy can match

os_version() {   # Unraid version from /etc/unraid-version (version="7.3.4"), or "unknown"
  local v
  v=$(sed -n 's/^version="\([0-9A-Za-z.+_-]\{1,40\}\)"[[:space:]]*$/\1/p' "$OS_ROOT/etc/unraid-version" 2>/dev/null | head -n1)
  echo "${v:-unknown}"
}

scan_os() {   # writes $WORK/os/{result,packages.txt,os.json,os.err}; needs $RUN_ID, $HARD_LIMIT, $tt
  local d src mounts=() ver kernel
  mkdir -p "$WORK/os"
  ver=$(os_version)
  kernel=$(clean "${OS_KERNEL:-$(uname -r)}" 60)
  find "$OS_ROOT/var/lib/pkgtools/packages" -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | LC_ALL=C sort | head -n 3000 \
    >"$WORK/os/packages.txt"
  for d in "${OS_DIRS[@]}"; do
    src="$OS_ROOT/$d"
    [ -d "$src" ] && [ ! -L "$src" ] || continue
    mounts+=(--mount "type=bind,source=$src,target=/rootfs/$d,readonly,bind-recursive=disabled")
  done
  progress os "$done" "$total" "Unraid OS $ver"
  OUT_FILE=$WORK/os/os.json; ERR_FILE=$WORK/os/os.err
  local res=failed why=''
  if [ ${#mounts[@]} -eq 0 ]; then
    why="none of the system directories (${OS_DIRS[*]}) found"
  elif trivy_container os "$NAME-$RUN_ID-os" --network none "${mounts[@]}" -v "$DATA/cache:/cache:ro" -- \
         rootfs "${TRIVY_COMMON[@]}" --cache-backend memory --skip-db-update --skip-java-db-update --offline-scan \
         --scanners vuln --format json --quiet --skip-dirs "$(IFS=,; echo "${OS_SKIP[*]}")" --timeout "$tt" /rootfs \
       && [ "$(head -c1 "$OUT_FILE")" = '{' ]; then
    res=ok
  else
    why=$(fail_reason)
  fi
  [ "$res" = ok ] || log "FAILED Unraid OS scan: $why"
  kv_write "$WORK/os/result" "result=$res" "error=$why" "version=$ver" "kernel=$kernel"
  done=$((done + 1))
  [ "$res" = ok ]
}

# ---------------------------------------------------------------- the scan
# The results of a run whose report could not be built are kept in $DATA/work-failed (one copy, never a symlink).
drop_failed_work() { local d=$DATA/work-failed; if [ -d "$d" ] && [ ! -L "$d" ]; then rm -rf -- "$d"; fi; return 0; }
keep_failed_work() { drop_failed_work; [ ! -e "$DATA/work-failed" ] && mv -f -- "$WORK" "$DATA/work-failed"; }

on_signal() {
  log "stop requested"
  [ -n "$CHILD" ] && kill "$CHILD" 2>/dev/null
  kill_containers "$RUN_ID"
  last_run stopped "scan stopped before it finished, the previous report is kept"
  exit 143
}
on_exit() {
  kill_containers "$RUN_ID"
  rm -f "$RUN/pid" "$RUN/progress" "$RUN"/db.out "$RUN"/db.err
  [ -n "${WORK:-}" ] && [ -d "$WORK" ] && rm -rf -- "$WORK"
}

take_lock() {
  mkdir -p "$RUN"
  exec 9>"$RUN/lock"
  flock -n 9 || { echo "a scan is already running"; exit 3; }
}

rotate_log() {
  [ -f "$LOG" ] && [ "$(stat -c %s "$LOG")" -gt 1048576 ] && { tail -n 2000 "$LOG" >"$LOG.tmp" && mv -f "$LOG.tmp" "$LOG"; }
  return 0
}

preflight() {   # common checks for run and update-db
  # first: with the array stopped (or appdata on a pool that is not mounted) the parent does not exist, and nothing
  # may be created there (not even last-run: mkdir -p would build /mnt/... in the RAM disk)
  if [ ! -d "$(dirname "$DATA")" ]; then
    log "$(dirname "$DATA") does not exist (array stopped, or Docker's appdata location is not mounted)"; exit 1
  fi
  if ! timeout 30 docker info >/dev/null 2>&1 9>&-; then
    last_run failed "Docker is not running"; log "Docker is not running"; exit 1
  fi
  if ! ensure_image; then last_run failed "could not pull the Trivy image"; log "pull failed"; exit 1; fi
}

do_run() {
  take_lock
  mkdir -p "$(dirname "$LOG")"; rotate_log
  exec >>"$LOG" 2>&1
  RUN_ID="$(date +%s)-$$"
  echo $$ >"$RUN/pid"
  trap on_signal TERM INT HUP
  trap on_exit EXIT
  load_config
  log "scan $RUN_ID started (scope=${C[SCOPE]} registry=${C[REGISTRY_CHECK]} os=${C[OS_SCAN]} timeout=${C[TIMEOUT]}m)"
  [ ${#CFG_PROBLEMS[@]} -gt 0 ] && warn "invalid settings ignored, defaults used: ${CFG_PROBLEMS[*]}"
  preflight
  if ! update_db; then
    last_run failed "no vulnerability database available (download failed), the previous report is kept"
    log "no vulnerability DB"; exit 1
  fi
  if [ "${C[JAVA_DB]}" = yes ] && [ ! -s "$DATA/cache/java-db/trivy-java.db" ]; then
    warn "no Java DB: images with Java packages will fail"
  fi

  WORK=$DATA/work
  rm -rf -- "$WORK"; mkdir -p "$WORK/local" "$WORK/remote" || { last_run failed "cannot create $WORK"; exit 1; }
  printf '%s\n' "${WARNINGS[@]}" >"$WORK/warnings.txt"

  if ! list_images; then last_run failed "docker ps failed"; exit 1; fi
  local n=${#IMG_ORDER[@]} i=0 id total done=0 refs=0
  : >"$WORK/images.tsv"; : >"$WORK/results.tsv"
  for id in "${IMG_ORDER[@]}"; do
    i=$((i + 1))
    describe_image "$id" "${IMG_NAME[$id]}"
    [ -n "$REF" ] && refs=$((refs + 1))
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$i" "$id" "$DISPLAY" "$REF" "$STALE" "$(clean "$DIGESTS" 2000)" \
      "${IMG_CONT[$id]}" "$NOREF" >>"$WORK/images.tsv"
  done
  total=$n
  [ "${C[REGISTRY_CHECK]}" = yes ] && total=$((n + refs))
  [ "${C[OS_SCAN]}" = yes ] && total=$((total + 1))
  log "$n image(s) to scan"

  HARD_LIMIT=$((C[TIMEOUT] * 60 + 120))
  local tt=${TRIVY_TIMEOUT_OVERRIDE:-${C[TIMEOUT]}m}
  # shellcheck disable=SC2034  # read_row fills all eight columns; not every loop uses each
  local idx disp ref stale dig cont noref
  while read_row; do
    progress scan "$done" "$total" "$disp"
    OUT_FILE=$WORK/local/$idx.json; ERR_FILE=$WORK/local/$idx.err
    if trivy_container local "$NAME-$RUN_ID-l$idx" --network none -v "$DOCKER_SOCK:/var/run/docker.sock:ro" \
         -v "$DATA/cache:/cache:ro" -- "${SCAN_COMMON[@]}" --image-src docker --timeout "$tt" "$id" \
       && [ "$(head -c1 "$OUT_FILE")" = '{' ]; then
      printf '%s\tlocal\tok\t\n' "$idx" >>"$WORK/results.tsv"
    else
      local why; why=$(fail_reason)
      log "FAILED $disp: $why"
      printf '%s\tlocal\tfailed\t%s\n' "$idx" "$why" >>"$WORK/results.tsv"
    fi
    done=$((done + 1))
  done <"$WORK/images.tsv"

  local osfail=0
  if [ "${C[OS_SCAN]}" = yes ]; then scan_os || osfail=1; fi

  if [ "${C[REGISTRY_CHECK]}" = yes ]; then
    local auth=()
    if [ "${C[REGISTRY_AUTH]}" = yes ] && [ -f "$REG_AUTH" ]; then auth=(-v "$REG_AUTH:/root/.docker/config.json:ro"); fi
    while read_row; do
      if [ -z "$ref" ]; then printf '%s\tremote\tskipped\t%s\n' "$idx" "$noref" >>"$WORK/results.tsv"; continue; fi
      if grep -q "^$idx"$'\t'"local"$'\t'"failed" "$WORK/results.tsv"; then
        printf '%s\tremote\tskipped\tlocal scan failed\n' "$idx" >>"$WORK/results.tsv"; done=$((done + 1)); continue
      fi
      progress registry "$done" "$total" "$ref"
      OUT_FILE=$WORK/remote/$idx.json; ERR_FILE=$WORK/remote/$idx.err
      if trivy_container remote "$NAME-$RUN_ID-r$idx" -e HOME=/root "${auth[@]}" -v "$DATA/cache:/cache:ro" -- \
           "${SCAN_COMMON[@]}" --image-src remote --timeout "$tt" "$ref" \
         && [ "$(head -c1 "$OUT_FILE")" = '{' ]; then
        printf '%s\tremote\tok\t\n' "$idx" >>"$WORK/results.tsv"
      else
        local why; why=$(fail_reason)
        log "registry check failed for $ref: $why"
        printf '%s\tremote\tfailed\t%s\n' "$idx" "$why" >>"$WORK/results.tsv"
      fi
      done=$((done + 1))
    done <"$WORK/images.tsv"
  fi

  progress report "$done" "$total" ""
  local out new
  # Unraid's php.ini keeps errors off the terminal, and its memory_limit is sized for web requests: a run with many
  # images (each Trivy JSON is decoded in full) needs more. Errors go to stderr, which ends up in the log.
  local arc=0
  out=$("$PHP" -d memory_limit="$AGG_MEMORY" -d display_errors=stderr -d log_errors=0 \
        "$PLUGIN_DIR/include/aggregate.php" "$WORK" "$DATA/report/report.json" \
        "scope=${C[SCOPE]}" "registry=${C[REGISTRY_CHECK]}" "trivy=${TRIVY_IMAGE#*:}" "cache=$DATA/cache" 2>&1 9>&-) || arc=$?
  if [ "$arc" -ne 0 ]; then
    # keep what was scanned, so the report can be rebuilt by hand without scanning again (replaced by the next failure,
    # removed by the next successful run)
    keep_failed_work && WORK=
    log "aggregate failed (exit $arc): $(tr '\n' ' ' <<<"${out:-no output}")"
    log "scan results kept in $DATA/work-failed; to retry the report: $PHP -d memory_limit=$AGG_MEMORY -d display_errors=stderr $PLUGIN_DIR/include/aggregate.php $DATA/work-failed $DATA/report/report.json"
    last_run failed "building the report failed (exit $arc), see the log"; exit 1
  fi
  drop_failed_work
  log "report: $(tr '\n' ' ' <<<"$out")"
  new=$(sed -n 's/^new_fixable_critical=\([0-9]*\)$/\1/p' <<<"$out")
  local nf what="$n image(s)"; nf=$(grep -c $'\tlocal\tfailed\t' "$WORK/results.tsv")
  if [ "${C[OS_SCAN]}" = yes ]; then what="$n image(s) and the Unraid OS"; nf=$((nf + osfail)); fi
  last_run ok "$what scanned, $nf failed"
  log "scan $RUN_ID finished: $what, $nf failed, new fixable critical: ${new:-0}"
  if [ "${C[NOTIFY]}" = yes ] && [ "${new:-0}" -gt 0 ] && [ -x "$NOTIFY_BIN" ]; then
    "$NOTIFY_BIN" -e "Trivy scan" -s "Trivy scan: $new new fixable critical vulnerabilities" \
      -d "$new critical CVE(s) with a fix available appeared since the last scan. See Settings, Trivy Scan." \
      -i alert -l "/Settings/TrivyScan" >/dev/null 2>&1 9>&-
  fi
  return 0
}

do_update_db() {
  take_lock
  exec >>"$LOG" 2>&1
  RUN_ID="$(date +%s)-$$"; echo $$ >"$RUN/pid"
  trap on_signal TERM INT HUP; trap on_exit EXIT
  load_config; preflight
  if update_db; then log "databases up to date"; else log "database update failed"; exit 1; fi
}

do_start() {
  if p=$(running_pid); then echo "a scan is already running (pid $p)"; return 0; fi
  mkdir -p "$RUN"
  setsid "$SELF" "$@" >/dev/null 2>&1 </dev/null &
  echo "scan started"
}

do_stop() {
  local p i
  if p=$(running_pid); then
    kill -TERM "$p" 2>/dev/null
    for i in $(seq 1 30); do pid_alive "$p" || break; sleep 1; done
    pid_alive "$p" && kill -KILL "$p" 2>/dev/null
  fi
  RUN_ID=; kill_containers
  rm -f "$RUN/pid" "$RUN/progress"
  echo "stopped"
}

do_status() {
  local p
  if p=$(running_pid); then echo "running=yes"; echo "pid=$p"; cat "$RUN/progress" 2>/dev/null; else echo "running=no"; fi
  [ -f "$DATA/report/last-run" ] && sed 's/^/last_/' "$DATA/report/last-run"
  return 0
}

do_apply() {
  load_config
  [ ${#CFG_PROBLEMS[@]} -gt 0 ] && echo "Invalid settings ignored (defaults used): ${CFG_PROBLEMS[*]}"
  mkdir -p "$(dirname "$CRON_FILE")"
  if [ -n "${C[SCHEDULE]}" ]; then
    printf '# %s: scheduled scan\n%s %s cron >/dev/null 2>&1\n' "$NAME" "${C[SCHEDULE]}" "$PLUGIN_DIR/scripts/trivy-scan" >"$CRON_FILE"
    echo "Scheduled scan: ${C[SCHEDULE]}"
  else
    rm -f "$CRON_FILE"
    echo "No scheduled scan"
  fi
  [ -x "$UPDATE_CRON" ] && "$UPDATE_CRON"
  return 0
}

do_uninstall() {
  load_config
  do_stop >/dev/null
  rm -f "$CRON_FILE"; [ -x "$UPDATE_CRON" ] && "$UPDATE_CRON"
  if [ "${C[REMOVE_DATA]}" = yes ]; then
    case $DATA in
      */$NAME)
        if [ -d "$DATA" ] && [ ! -L "$DATA" ]; then rm -rf -- "$DATA" && echo "removed $DATA"; fi ;;
      *) echo "refusing to remove unexpected data path $DATA" ;;
    esac
    if [[ $TRIVY_IMAGE =~ ^aquasec/trivy:[0-9.]+@sha256:[0-9a-f]{64}$ ]]; then
      docker rmi "$TRIVY_IMAGE" >/dev/null 2>&1 && echo "removed image $TRIVY_IMAGE"
    fi
  else
    echo "kept $DATA (vulnerability databases and the last report) and the Trivy image"
  fi
  rm -f "$RUN/lock"
  return 0
}

case ${1:-} in
  run|cron)  do_run ;;
  start)     do_start run ;;
  stop)      do_stop ;;
  update-db) if [ "${2:-}" = --foreground ]; then do_update_db; else do_start update-db --foreground; fi ;;
  status)    do_status ;;
  apply)     do_apply ;;
  config)    load_config; for k in $(printf '%s\n' "${!C[@]}" | sort); do echo "$k=${C[$k]}"; done
             [ ${#CFG_PROBLEMS[@]} -gt 0 ] && echo "INVALID=${CFG_PROBLEMS[*]}"; exit 0 ;;
  image)     echo "$TRIVY_IMAGE" ;;
  datadir)   echo "$DATA" ;;
  uninstall) do_uninstall ;;
  *) echo "usage: $0 start|run|cron|stop|update-db|status|apply|config|image|datadir|uninstall" >&2; exit 2 ;;
esac
